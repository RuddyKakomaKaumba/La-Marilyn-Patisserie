# ─────────────────────────────────────────────────────────────────────────────
# La Marilyn — variables d'environnement
# Copier ce fichier en `.env.local` (développement) et ne JAMAIS committer
# de vraies valeurs. En production, les renseigner chez l'hébergeur.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique du site (balises Open Graph). Ex. : https://www.lamarilyn.com
NEXT_PUBLIC_SITE_URL=

# ── Instagram (galerie « Quelques créations signées La Marilyn ») ────────────
# Lues UNIQUEMENT côté serveur. Sans elles, la galerie de secours s'affiche.

# Jeton d'accès Meta ayant accès au compte Instagram professionnel @lamarilyn2.
# Recommandé : jeton d'« utilisateur système » (Meta Business Suite) sans
# expiration, avec les permissions instagram_basic + pages_show_list
# (et business_management si le compte est dans un Business Manager).
META_ACCESS_TOKEN=

# Identifiant du compte Instagram professionnel (IG User ID, uniquement des
# chiffres — ce n'est PAS le nom d'utilisateur « lamarilyn2 »).
INSTAGRAM_ACCOUNT_ID=

# Optionnel — hôte de l'API :
#   graph.facebook.com  (défaut) : jeton obtenu via Facebook Login / utilisateur système
#   graph.instagram.com          : jeton obtenu via « Instagram API with Instagram Login »
META_GRAPH_API_HOST=

# Optionnel — version de l'API Graph (défaut : v25.0).
META_GRAPH_API_VERSION=
