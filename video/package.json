{
  "name": "la-marilyn-video",
  "version": "1.0.0",
  "private": true,
  "description": "Film de lancement du site La Marilyn (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:vertical": "remotion render src/index.ts LancementVertical exports/la-marilyn-lancement-vertical.mp4",
    "render:horizontal": "remotion render src/index.ts LancementHorizontal exports/la-marilyn-lancement-horizontal.mp4",
    "render:cover": "remotion still src/index.ts CouvertureReels exports/la-marilyn-couverture-reels.png",
    "render": "npm run render:vertical && npm run render:horizontal && npm run render:cover",
    "captures": "node scripts/capture-site.mjs",
    "audio": "python3 scripts/audio/build_audio.py",
    "typecheck": "tsc --noEmit",
    "tutoriel:captures": "node scripts/tutoriel/capture-parcours.cjs && python3 scripts/tutoriel/prepare.py",
    "tutoriel:musique": "python3 scripts/tutoriel/build_music.py",
    "tutoriel:render": "remotion render src/index.ts TutorielVertical exports/tutoriel/la-marilyn-tutoriel-vertical.mp4",
    "tutoriel:voix": "remotion render src/index.ts TutorielVoix exports/tutoriel/la-marilyn-tutoriel-voix-off.wav --codec=wav --audio-codec=pcm-16",
    "tutoriel:couverture": "remotion still src/index.ts CouvertureTutoriel exports/tutoriel/la-marilyn-tutoriel-couverture.jpg --image-format=jpeg --jpeg-quality=92",
    "tutoriel:apercu": "node scripts/preview.mjs TutorielVertical 0,200,520,900,1230,1600 0.35 && python3 scripts/sheet.py TutorielVertical out/apercu-tutoriel.jpg 6"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
